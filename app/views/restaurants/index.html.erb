<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <p class="text-uppercase text-muted small mb-1">Découvrez nos adresses</p>
      <h1 class="display-5 fw-bold mb-0">Restaurants</h1>
    </div>

    <%= link_to "＋ Ajouter un restaurant",
                new_restaurant_path,
                class: "btn btn-primary rounded-pill px-4" %>
  </div>

  <% if @restaurants.any? %>
    <div class="row g-4">
      <% @restaurants.each do |restaurant| %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm restaurant-card">
            <div class="card-body p-4">
              <span class="badge rounded-pill text-bg-light mb-3">
                <%= restaurant.category.capitalize %>
              </span>

              <h2 class="h4 fw-bold">
                <%= link_to restaurant.name,
                            restaurant_path(restaurant),
                            class: "text-decoration-none text-dark" %>
              </h2>

              <p class="text-muted mb-0">
                <i class="bi bi-geo-alt me-1"></i>
                <%= restaurant.address %>
              </p>
            </div>

            <div class="card-footer bg-white border-0 px-4 pb-4">
              <%= link_to "Voir le restaurant →",
                          restaurant_path(restaurant),
                          class: "btn btn-outline-primary rounded-pill" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center bg-light rounded-4 p-5">
      <h2 class="h4">Aucun restaurant pour le moment</h2>
      <p class="text-muted">Ajoute le premier restaurant à la liste.</p>
      <%= link_to "Ajouter un restaurant",
                  new_restaurant_path,
                  class: "btn btn-primary rounded-pill px-4" %>
    </div>
  <% end %>
</div>
