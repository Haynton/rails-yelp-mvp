<div class="container mt-4">
  <h1>Ajouter un restaurant</h1>

  <%= simple_form_for @restaurant do |f| %>
    <%= f.input :name, label: "Nom", input_html: { class: "form-control" } %>
    <%= f.input :address, label: "Adresse", input_html: { class: "form-control" } %>

    <%= f.input :category,
                label: "Catégorie",
                collection: %w[chinese italian japanese french belgian],
                prompt: "Choisir une catégorie",
                input_html: { class: "form-select" } %>

    <%= f.input :phone_number, label: "Tel", input_html: { class: "form-control" } %>

    <%= f.button :submit, "Ajouter le restaurant", class: "btn btn-primary mt-3" %>
  <% end %>
</div>
