<div class="container mt-4">
  <h1>New review for <%= @restaurant.name %></h1>

<div class="row">
  <div class="col-md-6">
    <%= simple_form_for [@restaurant, @review] do |f| %>
      <%= f.input :rating,
                label: "note",
                collection: [1, 2, 3, 4, 5],
                prompt: "Choisir une note",
                input_html: { class: "form-select" } %>
      <%= f.input :content %>
      <%= f.submit "Submit the review", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

</div>
